bash -lc 'set -e; PY=${{PYTHON:-$(command -v python3)}}; if [ -z "$PY" ] || [ ! -x "$PY" ]; then echo "ScheduleurmProbeError: no python3 available" >&2; exit 127; fi; CKPT_ROOT="{output_root}/checkpoints/{run_name}"; mkdir -p "$CKPT_ROOT"; exec "$PY" -u /tmp/scheduleurm_progress_wrapper_pkg/algorithm/experiments/progress_wrapper.py --unit step --total {max_iters} --stable-windows {stable_windows} --min-rate-samples {min_rate_samples} --stable-cv {stable_cv} --stable-rel-delta {stable_rel_delta} --stable-skip-samples {stable_skip_samples} -- "$PY" -u /tmp/scheduleurm_progress_wrapper_pkg/algorithm/experiments/cpu_parallel_progress_benchmark.py --steps {max_iters} --workers {workers} --work-items {work_items} --label "{run_name}" --log-interval {log_interval} --checkpoint-interval {checkpoint_interval} --checkpoint-dir "$CKPT_ROOT" --checkpoint-bytes {checkpoint_bytes} --final-save'
